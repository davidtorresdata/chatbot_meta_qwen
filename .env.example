# ------------------------------------------------------------------
# WhatsApp (Meta Cloud API) - fill with real values
# ------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
# App Secret from the Meta app dashboard (App settings -> Basic).
# When set, the /webhook endpoint verifies the X-Hub-Signature-256 header and
# rejects payloads that are not genuinely from Meta.
WHATSAPP_APP_SECRET=your_meta_app_secret

# ------------------------------------------------------------------
# Qwen LLM (served by the Ollama container)
# Host port 8001 maps to Ollama's OpenAI-compatible /v1 endpoint.
# In Docker, docker-compose.yml overrides this to http://ollama:11434/v1.
# ------------------------------------------------------------------
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen3.5:4b

# Conversation temperature (0 = deterministic, 1 = creative)
TEMPERATURE=0.3

# ------------------------------------------------------------------
# Embeddings (RAG knowledge base)
# openai_compat -> served by Ollama at the same endpoint (/v1/embeddings)
# local         -> sentence-transformers on this machine (requirements-local.txt)
# Change EMBEDDING_MODEL? Re-ingest: docker compose exec chatbot python scripts/ingest_cli.py knowledge_base/ --reset
# ------------------------------------------------------------------
EMBEDDING_BACKEND=openai_compat
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL=bge-m3

# Optional: alternate config file location
# CONFIG_PATH=config/config.yaml

# ------------------------------------------------------------------
# Caddy reverse proxy (optional but recommended for the public webhook).
# Compose overlay: docker compose -f docker-compose.yml -f docker-compose.caddy.yml up -d
# Default (CADDY_DOMAIN unset) -> Caddy listens on http://localhost:8080
# and forwards to the chatbot. No domain, certs, or firewall changes needed.
# For production HTTPS set your real domain below, point DNS to this machine,
# open firewall ports 80/443, and uncomment the 80/443 mappings in
# docker-compose.caddy.yml. Meta Callback URL then = https://<domain>/webhook
# CADDY_DOMAIN=bot.example.com
# CADDY_UPSTREAM=whatsapp-qwen-chatbot:8000

# ------------------------------------------------------------------
# Conversation registry: logs who contacted the bot (hora, numero, nombre,
# ciudad, empresa, pregunta, respuesta).
# Backend: none | sqlite | google_sheets  (docs/CONVERSATION_REGISTRY.md)
# ------------------------------------------------------------------
# CONVERSATION_LOG_ENABLED=1
# CONVERSATION_LOG_BACKEND=sqlite                      # sqlite | google_sheets
# CONVERSATION_LOG_DB_PATH=data/conversation_log.sqlite3
# CONVERSATION_LOG_CONTACTS_FILE=config/contacts.json  # optional enrichment
# CONVERSATION_LOG_COLUMNS=hora,numero,nombre,ciudad,empresa,pregunta,respuesta
# CONVERSATION_LOG_TIMEZONE=America/Bogota             # empty = UTC
# --- google_sheets backend ---
# CONVERSATION_LOG_SPREADSHEET_ID=1GB9LaRtZgtw4JEyK33uDH8IweOVh7aB_fv8ohjIhGcM
# CONVERSATION_LOG_WORKSHEET=Sheet1
# CONVERSATION_LOG_GOOGLE_AUTH_MODE=service_account   # service_account | oauth_user
#
# service_account mode (default):
# CONVERSATION_LOG_GOOGLE_CREDENTIALS_FILE=/app/credentials/gspread-sa.json
#
# oauth_user mode (your personal Google account, no service account needed):
#   A Google Sheets API does NOT support App passwords; the equivalent is an
#   OAuth2 login. Steps:
#   1) Google Cloud Console -> create an OAuth 2.0 Client ID of type "Desktop app"
#      and download client_secret.json into deploy/credentials/.
#   2) Set CONVERSATION_LOG_GOOGLE_AUTH_MODE=oauth_user and point
#      CONVERSATION_LOG_GOOGLE_CLIENT_SECRET_FILE at it (e.g.
#      /app/credentials/client_secret.json).
#   3) One-time login (opens browser, saves the refresh token):
#        docker compose exec -it chatbot python scripts/sheets_oauth_setup.py
#   4) The token file (CONVERSATION_LOG_GOOGLE_TOKEN_FILE, default
#      data/gspread_authorized_user.json) is reused from then on.
# CONVERSATION_LOG_GOOGLE_CLIENT_SECRET_FILE=/app/credentials/client_secret.json
# CONVERSATION_LOG_GOOGLE_TOKEN_FILE=data/gspread_authorized_user.json

# ------------------------------------------------------------------
# GPU servers only: the qwen-service folder serves Qwen 3.5 via vLLM
# (CUDA). If you use that stack instead of Ollama, set:
#   LLM_BASE_URL=http://<host>:8001/v1
#   LLM_MODEL=<the MODEL_NAME you set, e.g. Qwen/Qwen3.5-35B-A3B>
#   HF_TOKEN=<Hugging Face access token - required, gated model>
# and keep the token ONLY in an env file (never commit it).
# ------------------------------------------------------------------
# HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
