# Reverse proxy that gives the chatbot a public HTTPS webhook endpoint.
#
# ---------------------------------------------------------------------
# WORKS OUT OF THE BOX (local testing, no domain or certificate needed):
#
#     docker compose -f docker-compose.yml -f docker-compose.caddy.yml up -d
#     curl http://localhost:8080/health
#
# Caddy listens on :8080 for ANY Host and forwards to the chatbot container on
# port 8000. No DNS, no firewall changes, no certs. This also makes it the
# correct origin for a Cloudflare Tunnel (see docker-compose.tunnel.yml and
# deploy/README.md), whose requests carry the real Host (bot.fertrac.com).
#
# ---------------------------------------------------------------------
# PRODUCTION (HTTPS with automatic Let's Encrypt certificates):
#
#   1. In .env set the domain, e.g.   CADDY_DOMAIN=bot.example.com
#   2. Point a DNS A record at this machine's public IP.
#   3. Open ports 80/443 in the firewall (mapped in docker-compose.caddy.yml).
#   4. Run the same command above. Caddy obtains the certificate and
#      redirects port 80 -> 443 automatically.
#
#   Meta Callback URL: https://<CADDY_DOMAIN>/webhook
#   Meta Verify token: WHATSAPP_VERIFY_TOKEN from .env
# ---------------------------------------------------------------------

# Bind to any Host on port 8080 (http://:8080) so requests proxied through a
# Cloudflare Tunnel keep their real Host (e.g. bot.fertrac.com) and still reach
# the upstream. With CADDY_DOMAIN set (direct HTTPS mode) this site becomes that
# domain with automatic Let's Encrypt on 80/443.
{$CADDY_DOMAIN:http://:8080} {
	# Only the webhook and the liveness probe are public. /metrics, /ready and
	# the API docs are internal (Prometheus scrapes the container directly).
	@public path /webhook /health
	handle @public {
		# Upstream = chatbot service by default (DNS round-robin across replicas;
		# CADDY_UPSTREAM override, e.g. 127.0.0.1:8000 for host-run Caddy).
		reverse_proxy {$CADDY_UPSTREAM:chatbot:8000} {
			lb_policy round_robin
			health_uri /health
			health_interval 15s
		}
	}
	handle {
		respond 404
	}

	# Meta payloads are small; reject anything larger. The body is forwarded
	# unmodified, so the bot can verify X-Hub-Signature-256 over the raw bytes.
	request_body {
		max_size 1MB
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
	}
}
