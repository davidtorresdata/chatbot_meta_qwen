# =====================================================================
# Qwen 3.5 chat service - .env.example
# Copy to `.env` in this folder and fill in the real values.
# ---------------------------------------------------------------------
# The Hugging Face access token used to download the gated Qwen3.5 model.
# IMPORTANT: `.env` is git-ignored. Never commit the real token.
HF_TOKEN=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

# Model to serve (any public or gated Qwen3.5 repo id):
#   Qwen/Qwen3.5-0.8B   ~0.9B  (smallest)
#   Qwen/Qwen3.5-2B     ~2B
#   Qwen/Qwen3.5-4B     ~5B
#   Qwen/Qwen3.5-9B     ~10B
#   Qwen/Qwen3.5-27B    ~28B   (dense)
#   Qwen/Qwen3.5-35B-A3B      ~36B total / 3B active (MoE, RECOMMENDED)
#   Qwen/Qwen3.5-122B-A10B    ~125B MoE
#   Qwen/Qwen3.5-397B-A17B    ~403B MoE (flagship)
# FP8 / GPTQ-Int4 variants exist for most sizes (e.g. Qwen/Qwen3.5-35B-A3B-FP8).
MODEL_NAME=Qwen/Qwen3.5-35B-A3B

# Engine: gpu (default) = CUDA build | cpu = CPU-only build.
# For CPU use the compose override:
#   docker compose -f docker-compose.yml -f docker-compose.cpu.yml up -d --build
#   (and set MODEL_NAME to a small model like Qwen/Qwen3.5-4B)
VLLM_DEVICE=gpu

# Context window in tokens (lower = less GPU/CPU memory, higher = more).
MAX_MODEL_LEN=32768

# Max fraction of GPU memory vLLM may use (0.0 - 1.0).
GPU_MEMORY_UTILIZATION=0.90

# Optional alias exposed by /v1/models. Leave empty to use MODEL_NAME.
# SERVED_MODEL_NAME=Qwen3.5
# =====================================================================
